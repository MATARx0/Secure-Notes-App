NODE_ENV=development
PORT=3000
MONGO_URI=<mongodb-connection-string>
CLIENT_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be present and high-entropy or the app refuses to start (see src/utils/jwt.js).
JWT_SECRET=<generate-a-strong-random-secret-at-least-32-chars>
JWT_ISSUER=secure-notes-app
JWT_AUDIENCE=secure-notes-users
JWT_EXPIRES_IN=15m
# Separate, short lifetime for the opaque MFA ticket issued between password and TOTP steps.
MFA_TICKET_EXPIRES_IN=2m
# Label shown inside the authenticator app next to the account name.
MFA_ISSUER_NAME=SecureNotesApp

# Owned by Member 2. Must be exactly 32 bytes encoded as 64 hex characters
# (see src/utils/encryption.js). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<64-hex-character-key-32-bytes>

# Signs the CSRF double-submit cookie. Generate the same way as JWT_SECRET.
CSRF_SECRET=<generate-a-strong-random-secret-at-least-32-chars>

# Google reCAPTCHA v2 ("I'm not a robot" checkbox). Get keys at
# https://www.google.com/recaptcha/admin
CAPTCHA_PROVIDER=recaptcha-v2
CAPTCHA_SECRET_KEY=<provider-secret-key>
CAPTCHA_SITE_KEY=<provider-site-key>
# Only honoured when NODE_ENV is not "production" AND NODE_ENV is not "test"
# (tests inject a stub verifier instead). Lets a developer run the app
# locally without real reCAPTCHA keys. Never set this in production.
CAPTCHA_DEV_BYPASS=false

# One-time local/CI provisioning of the first administrator account.
# Used only by `npm run create-admin` (scripts/createAdmin.js). Not read
# by the running server and not exposed through any HTTP route.
ADMIN_EMAIL=<first-admin-email>
ADMIN_USERNAME=<first-admin-username>
ADMIN_PASSWORD=<temporary-strong-password-rotate-after-first-login>
