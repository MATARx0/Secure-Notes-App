NODE_ENV=development
PORT=3000
MONGO_URI=<mongodb-connection-string>
CLIENT_ORIGIN=http://localhost:3000

JWT_SECRET=<generate-a-strong-random-secret>
JWT_ISSUER=secure-notes-app
JWT_AUDIENCE=secure-notes-users
JWT_EXPIRES_IN=15m

ENCRYPTION_KEY=<32-byte-key-encoded-as-agreed-by-the-team>
CSRF_SECRET=<generate-a-strong-random-secret>

CAPTCHA_SECRET_KEY=<provider-secret-key>
CAPTCHA_SITE_KEY=<provider-site-key>